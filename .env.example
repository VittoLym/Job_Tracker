PORT=3000
NODE_ENV=development

# docker-compose sets DATABASE_URL, REDIS_URL, REDIS_HOST and REDIS_PORT for the API container.
# These values are for running the API on your machine with docker-compose.dev.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobtracker
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Gmail integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Obtained by opening /auth/google once
GOOGLE_REFRESH_TOKEN=
# Full Pub/Sub topic name, for example projects/<project-id>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
